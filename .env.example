# ---- WhatsApp (escolha UM modo) ----
# baileys = QR com seu número (padrão) | cloud = API oficial da Meta | demo = só simulador
WHATSAPP_MODE=baileys
# opcional: responder apenas a este número (com DDI, só dígitos). Vazio = conversa "Você".
BAILEYS_OWNER_JID=

# ---- Supabase (Passo 1) ----
# Settings → API do seu projeto
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- API oficial da Meta (só se WHATSAPP_MODE=cloud) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- IA para áudio/recibo ----
# mock = frases de exemplo (padrão) | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- diversos ----
PORT=3000
# persistência local opcional (se não usar Supabase)
FINZAP_DB=
